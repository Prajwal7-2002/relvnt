# =============================================================================
# RELVNT ENTERPRISE ENVIRONMENT CONFIGURATION
# =============================================================================

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,https://relvnt.vercel.app

# Optional: Google Gemini Live Intelligence (If omitted, uses local IsolationForest)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: Supabase PostgreSQL Persistence (If omitted, uses local zero-leak in-memory store)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=

# Optional: Meta Graph API (Instagram Business Insights)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Optional: Proactive Early-Warning Radar Webhook (Slack / Discord / Zapier)
WEBHOOK_ALERT_URL=
